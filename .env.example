# Saven - Environment Variables Example
# Salin file ini menjadi .env atau masukkan ke Dashboard Environment Variables Vercel

# Base URL aplikasi (contoh: https://saven.vercel.app atau http://localhost:3000)
APP_URL=https://saven.vercel.app

# JWT Secret untuk otentikasi session penjoki
JWT_SECRET=your_jwt_secret_here

# PostgreSQL Connection String (Supabase / Neon / AWS RDS)
POSTGRES_URL=postgres://user:password@host:6543/postgres?sslmode=require

# Supabase Storage Configuration (untuk upload & download file hasil tugas)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=order-results

# Web Push Notifications (VAPID)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=mailto:admin@example.com

# Upstash Redis / KV (untuk rate limiting & transient caching)
KV_REST_API_URL=https://your-upstash-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# Vercel Cron Secret (untuk mengamankan endpoint cron otomatis)
CRON_SECRET=your_cron_secret_here
